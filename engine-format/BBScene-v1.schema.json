{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BigBoom Engine Scene v1",
  "type": "object",
  "required": ["format", "version", "name", "objects"],
  "properties": {
    "format": { "const": "BBScene" },
    "version": { "const": 1 },
    "name": { "type": "string" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "position", "scale", "color"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "position": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 3, "maxItems": 3 },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "color": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 4, "maxItems": 4 }
        }
      }
    }
  }
}
